<%- include("partials/header.ejs") %>
    <title>EmD | Listings</title>
</head>

<body id="listings">
    <div class="container-fluid d-flex flex-column align-items-center">
        <div id="title_holder" class="mt-4">
            <a href="/" style="text-decoration: none;">
                <h1>EMPLOYMENT DIGGER</h1>
            </a>
        </div>

        <div class="search_box p-3 mt-2 w-100">
            <form action="/submit" method="post" class="row">
                <div class="col-5">
                    <label for="job_Title">Job Title</label>
                    <input type="text" name="job_Title" id="job_Title" class="form-control"
                    placeholder="Ex: Software Developer, Data Engineer, etc.">
                </div>

                <div class="col-3">
                    <label for="job_Country">Country</label>
                    <select id="job_Country" name="job_Country" class="form-control">
                        <option value="at">Austria</option>
                        <option value="au">Australia</option>
                        <option value="be">Belgium</option>
                        <option value="br">Brazil</option>
                        <option value="ca">Canada</option>
                        <option value="ch">Switzerland</option>
                        <option value="de">Germany</option>
                        <option value="es">Spain</option>
                        <option value="fr">France</option>
                        <option value="gb">United Kingdom</option>
                        <option value="in">India</option>
                        <option value="it">Italy</option>
                        <option value="mx">Mexico</option>
                        <option value="nl">Netherlands</option>
                        <option value="nz">New Zealand</option>
                        <option value="pl">Poland</option>
                        <option value="ru">Russia</option>
                        <option value="sg">Singapore</option>
                        <option value="us" selected>United States</option>
                        <option value="za">South Africa</option>
                    </select>
                </div>

                <div class="col-3">
                    <label for="post_Age">Maximum Post Age (Days)</label>
                    <input type="text" name="post_Age" id="post_Age" class="form-control"
                    placeholder="Ex: 60, 30, 20, 10, etc. ">
                </div>

                <div class="col-1 d-flex align-items-end justify-content-center">
                    <input class="btn btn-success" type="submit" value="Confirm">
                </div>
            </form>
        </div>

        <div class="job_postings mt-4">
            <% if(locals.listings) {%>
            <% listings.forEach(job => { %>
                <div class="card mb-4">
                    <div class="card-header bg-info p-3">
                        <h4 class="card-title">
                            <%= job.title %>
                        </h4>
                    </div>

                    <div class="card-body">
                        <h5 class="company_name card-subtitle text-primary">
                            <%= job.company %>
                        </h5>

                        <p class="card-text">
                            <small class="text-body-secondary">
                                Posted on <%= job.created %>
                            </small>
                        </p>

                        <p class="location card-text my-1">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= job.location %>
                        </p>
                        
                        <p class="card-text">
                            <%= job.description %>
                        </p>

                        <div class="d-flex justify-content-end">
                            <a target="_blank" href=<%= job.redirect_url %> class="apply_btn btn btn-warning">
                                Apply Now
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
            
            <% } else {%>
                <div>
                    <h2>ERROR</h2>
                </div>
            <% } %>
        </div>
    </div>
</body>

<%- include("partials/footer.ejs") %>